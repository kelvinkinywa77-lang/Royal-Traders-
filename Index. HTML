
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#090e1b">
<title>ROYAL TRADER | Trading Platform</title>

<style>
:root {
  --bg:#090e1b;
  --panel:#111a2d;
  --line:#24314b;
  --text:#f4f7ff;
  --muted:#91a0ba;
  --gold:#e8bd55;
  --green:#20c997;
  --red:#ff647c;
}

* {box-sizing:border-box}

body {
  margin:0;
  background:var(--bg);
  color:var(--text);
  font-family:Arial,sans-serif;
}

button,input,select {font:inherit}
button {cursor:pointer}

.container {
  max-width:1400px;
  margin:auto;
  padding:18px;
}

header {
  display:flex;
  justify-content:space-between;
  align-items:center;
  flex-wrap:wrap;
  gap:15px;
  padding:15px 0;
  border-bottom:1px solid var(--line);
}

.logo {
  font-size:24px;
  font-weight:bold;
  color:var(--gold);
  letter-spacing:2px;
}

.subtitle {
  font-size:10px;
  color:var(--muted);
  letter-spacing:3px;
}

.controls {
  display:flex;
  align-items:center;
  gap:8px;
  flex-wrap:wrap;
}

select,input {
  background:#091222;
  border:1px solid var(--line);
  color:white;
  padding:11px;
  border-radius:8px;
}

.mode button {
  background:#111a2d;
  color:white;
  border:1px solid var(--line);
  padding:10px 15px;
  border-radius:8px;
}

.mode button.active {
  background:var(--gold);
  color:black;
}

.dashboard {
  display:grid;
  grid-template-columns:minmax(0,1fr) 320px;
  gap:18px;
  margin-top:20px;
}

.stats {
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:12px;
}

.card {
  background:var(--panel);
  border:1px solid var(--line);
  padding:17px;
  border-radius:13px;
  margin-bottom:15px;
}

.label {
  color:var(--muted);
  font-size:12px;
}

.value {
  font-size:23px;
  font-weight:bold;
  margin-top:10px;
}

h3 {font-size:16px}

.market {
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:10px;
  margin:20px 0 12px;
}

.price {
  font-size:23px;
  font-weight:bold;
  margin:10px 0;
}

.chart {
  height:300px;
  width:100%;
}

canvas {
  width:100%;
  height:100%;
}

.warning {
  background:#2b2112;
  color:#f3d99d;
  padding:12px;
  border-radius:8px;
  font-size:12px;
  line-height:1.5;
  margin-bottom:15px;
}

.field {
  margin-bottom:14px;
}

.field label {
  display:block;
  color:var(--muted);
  font-size:12px;
  margin-bottom:7px;
}

.field input,.field select {
  width:100%;
}

.row {
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:10px;
}

.payout {
  display:flex;
  justify-content:space-between;
  background:#0a1825;
  padding:13px;
  border-radius:8px;
  margin-bottom:15px;
}

.payout strong {color:var(--green)}

.actions {
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:10px;
}

.trade {
  padding:16px 5px;
  border:0;
  border-radius:9px;
  background:var(--green);
  font-weight:bold;
  color:#06130e;
}

.sell {
  background:var(--red);
  color:#240810;
}

.trade:disabled {
  opacity:.4;
  cursor:not-allowed;
}

table {
  width:100%;
  border-collapse:collapse;
  font-size:12px;
}

th,td {
  text-align:left;
  padding:12px 7px;
  border-bottom:1px solid var(--line);
}

th {color:var(--muted)}

.up {color:var(--green)}
.down {color:var(--red)}

.watch {
  display:flex;
  justify-content:space-between;
  padding:13px 0;
  border-bottom:1px solid var(--line);
}

.watch small {
  display:block;
  color:var(--muted);
  margin-top:5px;
}

.quick {
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:10px;
}

.quick button {
  padding:13px 5px;
  border:1px solid var(--line);
  background:#091222;
  color:white;
  border-radius:8px;
}

footer {
  text-align:center;
  padding:25px;
  color:var(--muted);
  font-size:11px;
}

#toast {
  display:none;
  position:fixed;
  bottom:20px;
  left:50%;
  transform:translateX(-50%);
  background:#19243a;
  border:1px solid var(--line);
  padding:14px 20px;
  border-radius:9px;
  z-index:10;
}

@media(max-width:850px) {
  .dashboard {grid-template-columns:1fr}
}

@media(max-width:550px) {
  .container {padding:12px}
  .stats {gap:6px}
  .stats .card {padding:11px}
  .value {font-size:16px}
  .label {font-size:10px}
  .chart {height:240px}
  .market {align-items:flex-start;flex-direction:column}
}
</style>
</head>

<body>
<div class="container">

<header>
  <div>
    <div class="logo">ROYAL TRADER</div>
    <div class="subtitle">TRADE WITH DISCIPLINE</div>
  </div>

  <div class="controls">
    <div class="mode">
      <button id="demoTab" class="active"
        onclick="setMode('demo')">DEMO</button>
      <button id="realTab"
        onclick="setMode('real')">REAL</button>
    </div>

    <select id="currency" onchange="render()">
      <option value="KSh">KSh</option>
      <option value="USD">USD</option>
    </select>
  </div>
</header>

<div class="dashboard">

<main>

<div class="stats">
  <div class="card">
    <div class="label">AVAILABLE BALANCE</div>
    <div class="value" id="balance">KSh 100,000</div>
    <div class="label">Demo wallet</div>
  </div>

  <div class="card">
    <div class="label">TODAY'S P/L</div>
    <div class="value up" id="profit">KSh 0</div>
    <div class="label">Trading results</div>
  </div>

  <div class="card">
    <div class="label">OPEN TRADES</div>
    <div class="value" id="open">0</div>
    <div class="label">Active positions</div>
  </div>
</div>

<div class="market">
  <h3>Market Overview</h3>

  <select id="pair" onchange="changePair()">
    <option>EUR/USD</option>
    <option>GBP/USD</option>
    <option>USD/JPY</option>
    <option>BTC/USD</option>
    <option>XAU/USD</option>
  </select>
</div>

<div class="card">
  <div class="label" id="pairName">EUR/USD · SIMULATED</div>
  <div class="price" id="price">1.08425</div>

  <div class="chart">
    <canvas id="chart"></canvas>
  </div>

  <div class="label">
    Illustrative simulated prices. Not live market data.
  </div>
</div>

<div class="card">
  <h3>Recent Trades</h3>

  <div style="overflow-x:auto">
  <table>
    <thead>
      <tr>
        <th>ASSET</th>
        <th>TRADE</th>
        <th>STAKE</th>
        <th>RESULT</th>
        <th>STATUS</th>
      </tr>
    </thead>
    <tbody id="history">
      <tr>
        <td colspan="5">No trades yet.</td>
      </tr>
    </tbody>
  </table>
  </div>
</div>

</main>

<aside>

<div class="card">
  <h3>Place a Trade</h3>

  <div class="warning" id="notice">
    Demo mode uses virtual funds only.
    Trade outcomes are simulated.
  </div>

  <div class="field">
    <label>Investment Amount</label>
    <input type="number" id="stake"
      value="500" min="10" step="10"
      oninput="render()">
  </div>

  <div class="row">
    <div class="field">
      <label>Expiry Time</label>
      <select id="expiry">
        <option value="30">30 Seconds</option>
        <option value="60">1 Minute</option>
        <option value="300">5 Minutes</option>
      </select>
    </div>

    <div class="field">
      <label>Return</label>
      <input value="85%" disabled>
    </div>
  </div>

  <div class="payout">
    <span>Potential Profit</span>
    <strong id="potential">KSh 425</strong>
  </div>

  <div class="actions">
    <button class="trade" id="buy"
      onclick="trade('HIGHER')">
      ▲ HIGHER
    </button>

    <button class="trade sell" id="sell"
      onclick="trade('LOWER')">
      ▼ LOWER
    </button>
  </div>
</div>

<div class="card">
  <h3>Watchlist</h3>

  <div class="watch">
    <div>EUR/USD<small>Forex</small></div>
    <div>1.08425<small class="up">+0.12%</small></div>
  </div>

  <div class="watch">
    <div>GBP/USD<small>Forex</small></div>
    <div>1.27180<small class="down">-0.08%</small></div>
  </div>

  <div class="watch">
    <div>USD/JPY<small>Forex</small></div>
    <div>149.325<small class="up">+0.21%</small></div>
  </div>

  <div class="watch">
    <div>BTC/USD<small>Crypto</small></div>
    <div>67,420<small class="up">+0.44%</small></div>
  </div>
</div>

<div class="card">
  <h3>Account Actions</h3>

  <div class="quick">
    <button onclick="account('Deposit')">＋ Deposit</button>
    <button onclick="account('Withdraw')">↗ Withdraw</button>
    <button onclick="account('Profile')">◎ Profile</button>
    <button onclick="account('Support')">? Support</button>
  </div>
</div>

</aside>
</div>

<footer>
  ROYAL TRADER · Educational Trading Prototype
  <br><br>
  Demo prices and trade outcomes are simulated.
</footer>

</div>

<div id="toast"></div>

<script>
const balances = {
  KSh:100000,
  USD:700
};

const daily = {
  KSh:0,
  USD:0
};

let mode = 'demo';
let openTrades = 0;
let trades = [];
let price = 1.08425;
let prices = [];

const bases = {
  'EUR/USD':1.08425,
  'GBP/USD':1.27180,
  'USD/JPY':149.325,
  'BTC/USD':67420,
  'XAU/USD':2342.5
};

function money(value,currency) {
  if(currency === 'USD') {
    return '$' + value.toLocaleString('en-US',{
      minimumFractionDigits:2,
      maximumFractionDigits:2
    });
  }

  return 'KSh ' + value.toLocaleString('en-KE',{
    minimumFractionDigits:2,
    maximumFractionDigits:2
  });
}

function notify(message) {
  const box = document.getElementById('toast');
  box.textContent = message;
  box.style.display = 'block';

  setTimeout(() => {
    box.style.display = 'none';
  },3000);
}

function render() {
  const c = document.getElementById('currency').value;

  document.getElementById('balance').textContent =
    money(balances[c],c);

  document.getElementById('profit').textContent =
    money(daily[c],c);

  document.getElementById('open').textContent =
    openTrades;

  const stake = Number(
    document.getElementById('stake').value
  );

  document.getElementById('potential').textContent =
    money(stake * 0.85,c);
}

function setMode(m) {
  mode = m;

  document.getElementById('demoTab')
    .classList.toggle('active',m === 'demo');

  document.getElementById('realTab')
    .classList.toggle('active',m === 'real');

  const real = m === 'real';

  document.getElementById('notice').textContent =
    real
    ? 'Real trading is disabled. A licensed broker, compliant payment system and regulatory approval are required before accepting real funds.'
    : 'Demo mode uses virtual funds only. Trade outcomes are simulated.';

  document.getElementById('buy').disabled = real;
  document.getElementById('sell').disabled = real;

  render();

  if(real) {
    notify('Real trading is not activated.');
  }
}

function trade(direction) {
  if(mode !== 'demo') {
    notify('Real trading is disabled.');
    return;
  }

  const c = document.getElementById('currency').value;
  const stake = Number(
    document.getElementById('stake').value
  );

  const expiry = Number(
    document.getElementById('expiry').value
  );

  if(!Number.isFinite(stake) || stake < 10) {
    notify('Minimum demo stake is 10.');
    return;
  }

  if(stake > balances[c]) {
    notify('Insufficient demo balance.');
    return;
  }

  balances[c] -= stake;
  openTrades++;

  render();

  notify(direction + ' demo trade opened.');

  const pair = document.getElementById('pair').value;

  setTimeout(() => {

    const won = Math.random() > 0.48;

    const profit = won ? stake * 0.85 : -stake;

    if(won) {
      balances[c] += stake + profit;
    }

    daily[c] += profit;

    openTrades--;

    trades.unshift({
      pair,
      direction,
      stake,
      profit,
      currency:c,
      status:won ? 'WIN' : 'LOSS'
    });

    renderHistory();
    render();

    notify(
      'Demo trade ' +
      (won ? 'WON' : 'LOST') +
      ': ' + money(profit,c)
    );

  },expiry * 1000);
}

function renderHistory() {
  const history = document.getElementById('history');

  if(trades.length === 0) {
    history.innerHTML =
      '<tr><td colspan="5">No trades yet.</td></tr>';
    return;
  }

  history.innerHTML = trades.slice(0,15).map(t => `
    <tr>
      <td>${t.pair}</td>
      <td>${t.direction}</td>
      <td>${money(t.stake,t.currency)}</td>
      <td class="${t.profit >= 0 ? 'up':'down'}">
        ${money(t.profit,t.currency)}
      </td>
      <td>${t.status}</td>
    </tr>
  `).join('');
}

function account(action) {
  notify(
    action +
    ' is not connected yet. This is a demo interface.'
  );
}

function changePair() {
  const pair = document.getElementById('pair').value;

  price = bases[pair];

  document.getElementById('pairName').textContent =
    pair + ' · SIMULATED';

  prices = [];

  for(let i=0;i<50;i++) {
    prices.push(
      price + (Math.random()-.5)*price*.002
    );
  }

  drawChart();
}

function tick() {
  const pair = document.getElementById('pair').value;

  let scale = pair.includes('JPY') ? .025 :
    pair.includes('BTC') ? 15 :
    pair.includes('XAU') ? .5 : .00008;

  price += (Math.random()-.48)*scale;

  prices.push(price);

  if(prices.length > 55) prices.shift();

  document.getElementById('price').textContent =
    price.toFixed(
      pair.includes('JPY') ? 3 :
      pair.includes('BTC') || pair.includes('XAU') ? 2 : 5
    );

  drawChart();
}

function drawChart() {
  const canvas = document.getElementById('chart');
  const ctx = canvas.getContext('2d');

  const w = canvas.clientWidth;
  const h = canvas.clientHeight;
  const dpr = window.devicePixelRatio || 1;

  canvas.width = w*dpr;
  canvas.height = h*dpr;

  ctx.setTransform(dpr,0,0,dpr,0,0);
  ctx.clearRect(0,0,w,h);

  for(let i=0;i<5;i++) {
    const y = i*h/4;

    ctx.strokeStyle = '#25324a';
    ctx.beginPath();
    ctx.moveTo(0,y);
    ctx.lineTo(w,y);
    ctx.stroke();
  }

  const min = Math.min(...prices);
  const max = Math.max(...prices);
  const range = max-min || 1;

  ctx.beginPath();

  prices.forEach((v,i) => {
    const x = i*w/(prices.length-1);
    const y = h-((v-min)/range)*(h-22)-11;

    if(i===0) ctx.moveTo(x,y);
    else ctx.lineTo(x,y);
  });

  ctx.strokeStyle = '#e8bd55';
  ctx.lineWidth = 2;
  ctx.stroke();
}

document.getElementById('stake')
  .addEventListener('input',render);

window.addEventListener('resize',drawChart);

changePair();
render();

setInterval(tick,1400);
</script>
</body>
</html>
